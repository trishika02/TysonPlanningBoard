# Local Frappe bench server (default for local development)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Staging server (used in vercel.json rewrites for the deployed app)
# VITE_API_BASE_URL=https://manami-stage.altersense.net

# Company name shown in the top nav — logo is looked up at /static/{name}.png (lowercase)
# Available logos: static/mim.png, static/manami.png
# VITE_SITE_NAME=manami
VITE_SITE_NAME=mim
